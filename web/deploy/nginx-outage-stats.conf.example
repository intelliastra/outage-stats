# Adapt domain, certificate paths and auth file for the target server.
server {
    listen 80;
    server_name outage-stats.example.com;
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name outage-stats.example.com;

    ssl_certificate     /etc/letsencrypt/live/outage-stats.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/outage-stats.example.com/privkey.pem;
    client_max_body_size 155m;

    location / {
        proxy_pass http://127.0.0.1:22329;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

